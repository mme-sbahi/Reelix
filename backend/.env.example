# App
NODE_ENV=development
PORT=3001

# Database (matches docker-compose service name "postgres")
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=hypertube
DATABASE_PASSWORD=hypertube_password
DATABASE_NAME=hypertube_db

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRATION=7d

# CORS (frontend origin, used from Day 3 onward)
CORS_ORIGIN=http://localhost:3000

# TMDB
TMDB_API_KEY=82de27ef269bacf773b06bc098427399
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# Archive.org fallback stream source
ARCHIVE_ORG_BASE_URL=https://archive.org

# OpenSubtitles REST API (https://www.opensubtitles.com/consumers)
# Register free at opensubtitles.com, create a consumer, and paste your Api-Key here.
OPENSUBTITLES_API_KEY=XJx3DrJkgQnBEvF4uIc4tOLhs8xvjIAA

# Google OAuth
GOOGLE_CLIENT_ID=replace_with_client_ID
GOOGLE_CLIENT_SECRET=replace_with_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

